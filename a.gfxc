texture bufferBg
    path: "@R"
    hasData: false
    width: 320
    height: 480
end

region bg
    tex: bufferBg
    x: 0.0f
    y: 0.0f
    width: 320.0f
    height: 480.0f
end

script bgRenderer
    region bg
    filter FILTER_NEAREST
    origin ORIGIN_SURFACE
    pos 160, 0
    color 0xFFFFFF
end
